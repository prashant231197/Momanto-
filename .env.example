# ═══════════════════════════════════════════════════════════════════
# MOMANTO ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# Copy this to .env (or configure in Railway Variables dashboard)
# ═══════════════════════════════════════════════════════════════════

# Server & Mode
PORT=3000
NODE_ENV=production
NEXT_PUBLIC_SITE_URL=https://your-railway-app.up.railway.app
NEXT_PUBLIC_API_URL=https://your-railway-app.up.railway.app

# Authentication & Security
JWT_SECRET=your_super_strong_jwt_secret_momanto_2026

# Database (PostgreSQL recommended on Railway)
# In Railway: Add PostgreSQL service and link DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://postgres:password@localhost:5432/momanto

# UPI & Payments
MOMANTO_UPI_VPA=momanto@upi
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# SMS Dispatch (Fast2SMS)
FAST2SMS_API_KEY=
ENABLE_ORDER_SMS=false

# WhatsApp Gateways
# Mode 1: Green-API
GREEN_API_ID_INSTANCE=
GREEN_API_TOKEN=
GREEN_API_API_URL=https://api.green-api.com

# Mode 2: UltraMsg
ULTRAMSG_INSTANCE_ID=
ULTRAMSG_TOKEN=

# Mode 3: Meta Cloud WhatsApp Business API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Twilio (SMS & WhatsApp backup)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=

# Telegram Bot Notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
